# Copy to .env (gitignored) and fill in. Never commit real keys.
GITHUB_TOKEN=
# One or more Gemini keys, comma-separated. The backend rotates them, cools down
# rate-limited keys and drops invalid ones. Quota is per Google Cloud project, so
# keys from different projects add capacity; keys from one project only add failover.
GEMINI_API_KEYS=
# Optional overrides
# GEMINI_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-flash-latest
# GEMINI_THINKING_LEVEL=minimal
SECRET_KEY=
# DATABASE_URL=postgresql://...
